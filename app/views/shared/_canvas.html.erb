<div class="row">
  <div>
    <input type="file" id="imageInput" accept="image/*">
    <label for="imageInput" class="custom-file-btn" id="imageSelectLabel"></label>
  </div>
  <div id="Filter-popup-overlay" class="popup-overlay">
    <div id="popup">
      <h3>画像選択について</h3>
      <p>
        「画像を選択」から画像を選んでください<br>
        以下のフィルターを選択した状態で画像を選択した場合、キャンバスへの投影時に補正をかけます<br>
      </p>
      <div class="popup-buttons">
        <button id="selectImage" class="btn-primary">画像を選択</button>
        <button class="filter-btn" data-filter="pastel">パステルカラー</button>
        <button class="filter-btn" data-filter="warm">暖色系</button>
        <button class="filter-btn" data-filter="cool">寒色系</button>
        <button id="Filter-closePopup" class="btn-secondary">キャンセル</button>
      </div>
    </div>
  </div>
  <canvas id="hiddenCanvas" style="display:none;"></canvas>
  <div class="col-12 d-flex  justify-content-center">
    <div class="canvas-wrapper">
      <div id="pixelCanvas" class="pixel-canvas"></div>
      <div id="circlePreview" class="circle-preview"></div>
    </div>
  </div>
</div>

<script>
  var selectedFilter = null;
  var CANVAS_SIZE = CANVAS_SIZE || 500;
  var gridSize = 32;
  var currentColor = "rgb(0, 0, 0)";

  function createCanvas(size = gridSize) {
    gridSize = size;

    const canvas = document.getElementById("pixelCanvas");
    if (!canvas) return;

    canvas.style.gridTemplateColumns = `repeat(${gridSize}, 1fr)`;
    canvas.style.gridTemplateRows = `repeat(${gridSize}, 1fr)`;

    canvas.innerHTML = "";

    let isMouseDown = false;
    document.addEventListener("mousedown", () => isMouseDown = true);
    document.addEventListener("mouseup", () => isMouseDown = false);

    for (let i = 0; i < gridSize * gridSize; i++) {
      const pixel = document.createElement("div");
      pixel.classList.add("pixel");

      pixel.addEventListener("mousedown", () => {
        pixel.style.backgroundColor = currentColor;
      });

      pixel.addEventListener("mouseover", () => {
        if (isMouseDown) {
          pixel.style.backgroundColor = currentColor;
        }
      });

      canvas.appendChild(pixel);
    }
    const imageInput = document.getElementById("imageInput");
    if (imageInput) imageInput.value = "";
  }

  document.addEventListener("turbo:load", () => {
    selectedFilter = null;
    const imageInput = document.getElementById("imageInput");
    const hiddenCanvas = document.getElementById("hiddenCanvas");
    const imageSelectLabel = document.getElementById("imageSelectLabel");
    const popupOverlay = document.getElementById("Filter-popup-overlay");
    const closePopup = document.getElementById("Filter-closePopup");
    const selectImageBtn = document.getElementById("selectImage");
    const filterButtons = document.querySelectorAll(".filter-btn");

    if (!imageInput || !hiddenCanvas) return;

    imageSelectLabel.addEventListener("click", (e) => {
      e.preventDefault();
      popupOverlay.style.display = "flex";
    });

    closePopup.addEventListener("click", () => {
      popupOverlay.style.display = "none";
    });

    selectImageBtn.addEventListener("click", () => {
      popupOverlay.style.display = "none";
      imageInput.click();
    });

    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        if (btn.classList.contains("active")) {
          btn.classList.remove("active");
          selectedFilter = null;
        } else {
        filterButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        selectedFilter = btn.dataset.filter;
        }
      });
    });

    const ctx = hiddenCanvas.getContext("2d");

    imageInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const img = new Image();
      img.src = URL.createObjectURL(file);

      img.onload = () => {
      drawImageToPixelCanvas(img);
      };
    });

    function applyFilter(r, g, b) {
      switch (selectedFilter) {
        case "pastel":
          return [
            Math.min(255, r + (255 - r) * 0.4),
            Math.min(255, g + (255 - g) * 0.4),
            Math.min(255, b + (255 - b) * 0.4)
          ];

          case "warm":
            return [
              Math.min(255, r + 30),
              g,
              Math.max(0, b - 20)
            ];

            case "cool":
              return [
                Math.max(0, r - 20),
                g,
                Math.min(255, b + 30)
              ];

              default: return [r, g, b];
      }
    }

    function drawImageToPixelCanvas(img) {
      hiddenCanvas.width = gridSize;
      hiddenCanvas.height = gridSize;

      ctx.clearRect(0, 0, gridSize, gridSize);
      ctx.drawImage(img, 0, 0, gridSize, gridSize);

      const imageData = ctx.getImageData(0, 0, gridSize, gridSize).data;
      const pixels = document.querySelectorAll("#pixelCanvas .pixel");

      pixels.forEach((pixel, index) => {
        let r = imageData[index * 4];
        let g = imageData[index * 4 + 1];
        let b = imageData[index * 4 + 2];
        const a = imageData[index * 4 + 3] / 255;

        [r, g, b] = applyFilter(r, g, b);

        pixel.style.backgroundColor = `rgba(${r}, ${g}, ${b}, ${a})`;
      });
    }

    createCanvas();

    if (window.editIconData) {
      const { gridSize: saveGridSize, pixels } = window.editIconData;

      createCanvas(saveGridSize);

      const pixelEls = document.querySelectorAll("#pixelCanvas .pixel");

      pixelEls.forEach((pixel, index) => {
        pixel.style.backgroundColor = pixels[index];
      });
    }
  });
</script>